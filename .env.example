# ─────────────────────────────────────────────────────────────
# Sahulatcart — environment template. Copy to .env; NEVER commit .env.
# The backend fails fast on boot if a REQUIRED var is missing.
# ─────────────────────────────────────────────────────────────

PRODUCT_NAME=Sahulatcart
NODE_ENV=development
LOG_LEVEL=info
# PORT is injected by the host (Railway/Render). Do not set it in production.

# ── Supabase — REQUIRED (only these are validated at boot) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM — Gemini is the ONLY implemented provider. ──
# LLM_PROVIDER=anthropic throws at runtime; there is no OpenAI client.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Meta WhatsApp Cloud API ──
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=          # you invent this; must match Meta's webhook config
META_SYSTEM_USER_TOKEN=             # pilot only: used solely for META_DEFAULT_PHONE_NUMBER_ID until that merchant reconnects
META_DEFAULT_PHONE_NUMBER_ID=       # must also exist as a row in whatsapp_numbers
META_GRAPH_API_VERSION=v25.0              # required in production (the backend will not boot without it); v25.0 is available until 2028-07-29
META_EMBEDDED_SIGNUP_CONFIG_ID=     # Facebook Login for Business → Configurations → the WhatsApp Embedded Signup config (M7 step 2)

# ── Merchant alerts (P3). A missing key just skips that channel. ──
# VAPID pair: `npx web-push generate-vapid-keys` (run once; the public key is served by /config)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sahulatcart.com
RESEND_API_KEY=                     # resend.com → API keys
# Billing (P7). Prices in paisa; bank details are multi-line with literal \n. Merchants pay Nubrix by transfer.
PLAN_BASIC_PRICE_PAISA=299900       # Rs 2,999 a month, 1,000 conversations
PLAN_PRO_PRICE_PAISA=799900         # Rs 7,999 a month, 5,000 conversations
PLATFORM_BANK_DETAILS=Nubrix Technologies (Pvt) Ltd\nMeezan Bank\nAccount: 0000-0000000\nIBAN: PK00MEZN0000000000000000
SENTRY_DSN=                         # P6: backend error reporting; empty = off
NEXT_PUBLIC_SENTRY_DSN=             # P6: admin portal (client + server); public by design, baked at build
ALERT_EMAIL_FROM=Sahulatcart <onboarding@resend.dev>   # alerts@sahulatcart.com once the domain is verified (DKIM/SPF in Cloudflare)
ADMIN_ORIGIN=https://appadmin-production-0a30.up.railway.app   # links inside alert emails

# ── Self-service signup (P1) ──
SIGNUP_OPEN=false                   # fallback only: production sets sign-up in /platform/access (platform_settings)
SIGNUP_ALLOWLIST=                   # fallback only: comma-separated emails; the panel's list wins once saved

# ── Generate locally: openssl rand -hex 32 ──
ADMIN_API_TOKEN=                    # grants platform-admin via x-admin-token
TOKEN_ENCRYPTION_KEY=               # 32 bytes, hex or base64 (openssl rand -hex 32); seals whatsapp_secrets; required in production
SERVICE_HMAC_SECRET=                # reserved, not yet read by any code

# ── Storage buckets (created by db/seed.mjs) ──
STORAGE_BUCKET_PRODUCT_IMAGES=product-images
STORAGE_BUCKET_PAYMENT_SCREENSHOTS=payment-screenshots
STORAGE_BUCKET_INBOUND_MEDIA=inbound-media
STORAGE_BUCKET_ORDER_SLIPS=order-slips
STORAGE_BUCKET_CATALOG_IMPORTS=catalog-imports

WEBHOOK_MAX_BODY_BYTES=131072

# ── Migrations only (db/migrate.mjs). Not needed by the running app. ──
# Supabase direct host is IPv6-only; use the session pooler for IPv4.
SUPABASE_DB_URL=
