# ─────────────────────────────────────────────────────────────
# Sahulatkaar — environment (copy to .env; NEVER commit .env)
# Canonical env-var names — see docs/spec/09-nonfunctional-devops.md
# The backend fails fast on boot if any REQUIRED var is missing/empty.
# ─────────────────────────────────────────────────────────────

# Brand name is CONFIG, not final. Renaming the product later = change this.
PRODUCT_NAME=Sahulatkaar

# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Supabase (required)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic / Claude (required for the bot brain — Phase 3+)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8            # ⚠️ VERIFY LIVE against claude-api reference
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5  # ⚠️ VERIFY LIVE

# Meta WhatsApp Cloud API (required for the WhatsApp pipe — Phase 2+)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_SYSTEM_USER_TOKEN=
META_GRAPH_API_VERSION=v21.0               # ⚠️ VERIFY LIVE
META_DEFAULT_PHONE_NUMBER_ID=              # Path C: the pilot/test number id

# Secrets / crypto
TOKEN_ENCRYPTION_KEY=                       # 32-byte hex for whatsapp_secrets (AES-256-GCM)
SERVICE_HMAC_SECRET=                        # internal service→service HMAC

# Storage bucket names
STORAGE_BUCKET_PRODUCT_IMAGES=product-images
STORAGE_BUCKET_PAYMENT_SCREENSHOTS=payment-screenshots
STORAGE_BUCKET_INBOUND_MEDIA=inbound-media
STORAGE_BUCKET_ORDER_SLIPS=order-slips
STORAGE_BUCKET_CATALOG_IMPORTS=catalog-imports

# Abuse limits (Phase 6)
WEBHOOK_MAX_BODY_BYTES=131072
